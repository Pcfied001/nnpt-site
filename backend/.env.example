# copy this to .env and fill in real values. don't commit .env itself.

PORT=3000

# admin login for /admin.html + the GET endpoints that show real applicant data.
# falls back to an insecure dev login if unset (prints a warning on startup)
ADMIN_USER=change-this-username
ADMIN_PASS=change-this-to-a-strong-password

# --- email confirmations ---
# sends a "we got it" email to whoever fills out Apply or Contact.
# skipped silently if these aren't set, nothing else breaks.
# works with basically any SMTP provider — Gmail (needs an App Password,
# not your normal one), your host's email, or something like Brevo/SendGrid
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=secretariat@nnpolo.org
